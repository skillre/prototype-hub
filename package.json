{
  "name": "prototype-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node scripts/check-qa-port.mjs && playwright test",
    "qa": "node scripts/check-qa-port.mjs && node .qa/browser-qa.mjs",
    "qa:online": "node .qa/online-qa.mjs",
    "catalog:sync": "node scripts/sync-factory-catalog.mjs",
    "catalog:check": "node scripts/sync-factory-catalog.mjs --check",
    "factory:agents": "node scripts/guard-agent-policy.mjs",
    "factory:deploy": "node scripts/verify-deployment.mjs",
    "check": "pnpm factory:agents && pnpm catalog:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm qa"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.43.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.3.4"
}
