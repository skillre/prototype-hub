{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prototype-factory.local/schemas/hub-factory-lock.schema.json",
  "title": "Factory Governance Lock · platform / catalog-hub",
  "description": "平台/目录仓（prototype-hub）自己的治理锁，形态 `kind: catalog-hub`。\n\n**它不是 product 锁。** 产品锁描述「从哪一版基线派生、初始化到哪一步、部署到哪个 Vercel 项目」；hub 没有派生来源，也不是被初始化的产品。把产品形状套上去会让「基线身份」与「部署归属」两件事同时变成谎话，所以这里用一套诚实的平台形状：它记录自己的包名/版本/采纳时刻 SHA、采纳了哪一版工厂与政策、政策来源的确切 commit、catalog 投影的产物与命令、受管面，以及**未决项**（value 恒为 null，probe 写清楚怎么核的、结果是什么）。\n\n锁记的是「采纳那一刻的快照」，不是「当前 HEAD」——HEAD 前进不会让锁失效，但两个值都必须能解释。\n\n本文件是**仓内 schema**（`pnpm factory:agents` 用它校验本仓的锁），比根契约更严（要求 deployment 段与 readOnlyAtRuntime const true）；根控制面的 contracts/factory-lock.schema.json 已用第四支 `catalog-hub` 接纳这种形状（该支从根仓 fdbfbae 起就在，2026-09-16 又由 5f9a6b1 补上本锁的四个 provenance 字段），控制面的 drift 因此不再对本仓报 `factory-lock-off-contract`。本仓不改回产品形状的理由不变：`kind: catalog-hub` 是更准确的描述。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "hub",
    "adoption",
    "policy",
    "projection",
    "managedSurfaces",
    "unresolved",
    "note"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "enum": [
        "catalog-hub"
      ],
      "description": "平台/目录仓的形状。只有这一个合法取值：本仓不得伪装成 factory-baseline 或 product。"
    },
    "hub": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageName",
        "version",
        "commit",
        "recordedOn"
      ],
      "description": "被锁定的平台身份。`commit` 是采纳治理那一刻的基线 HEAD，不是「当前 HEAD」。",
      "properties": {
        "packageName": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "读自 package.json 的 version。"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "采纳治理时的 HEAD SHA（40 位）。HEAD 之后前进是正常的，锁不会因此失效——但必须能说出它是哪一次。"
        },
        "recordedOn": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "adoption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factoryVersion",
        "policyVersion",
        "policySource",
        "adoptedBy"
      ],
      "description": "采纳了哪一版工厂与哪一版政策，以及政策来源的确切 commit。来源必须可核：写一个「大概是这样」的 commit 比留空更危险。",
      "properties": {
        "factoryVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "工厂发布版本（与 catalog/compatibility.json 的 supportedVersionRange 同一坐标系）。"
        },
        "policyVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "policySource": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repo",
            "commit"
          ],
          "properties": {
            "repo": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$",
              "description": "包含 factory-policy.json / 本地 schema / 校验器的那个 commit。"
            },
            "subject": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "adoptedBy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "const": "1.3.0",
          "description": "与 factory-policy.json 的 policyVersion 必须一致。"
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "generator",
        "syncCommand",
        "checkCommand",
        "sourceRoot",
        "sourceSha",
        "inputsDigest",
        "readOnlyAtRuntime",
        "standaloneHonesty"
      ],
      "description": "catalog 投影：本仓拥有、别的仓没有的那个面。",
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "generator": {
          "type": "string",
          "minLength": 1
        },
        "syncCommand": {
          "type": "string",
          "minLength": 1
        },
        "checkCommand": {
          "type": "string",
          "minLength": 1
        },
        "sourceRoot": {
          "type": "string",
          "minLength": 1
        },
        "sourceSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "生成物记录的根控制面 SHA（artifact.source.gitSha）。null 不是一个可以写进锁的值：拿不到 SHA 说明生成物本身要重新锚定。"
        },
        "inputsDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "readOnlyAtRuntime": {
          "const": true,
          "description": "运行时只读生成物、不跨仓读取——这是本仓的不变式，不是实现细节。"
        },
        "standaloneHonesty": {
          "type": "string",
          "minLength": 1,
          "description": "根控制面不可用时会发生什么。必须写明「报告 upstream unavailable，不判 PASS」。"
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "projectName",
        "projectId",
        "latestProductionUrl",
        "anonymousAccess",
        "observedOn",
        "source"
      ],
      "description": "本仓部署身份中**已核实**的那一部分。刻意只放能拿出来的字段：项目名/ID、最新 Production URL、匿名可访问性，以及线上那一次生产部署的 SHA 与它的出处。**每一项断言都带出处**：没有被回读的东西不写在这里，而是留在 unresolved（value: null）。",
      "properties": {
        "provider": {
          "enum": [
            "vercel"
          ]
        },
        "projectName": {
          "type": "string",
          "minLength": 1
        },
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "latestProductionUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "anonymousAccess": {
          "enum": [
            "public",
            "protected",
            "unknown"
          ],
          "description": "只有匿名请求返回 2xx 才允许写 public；受保护写 protected；没探测写 unknown。"
        },
        "observedOn": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "latestProductionSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$",
          "description": "线上那一次生产部署的 git SHA（来自控制面的部署记录回读，不是从 URL 推断）。"
        },
        "latestProductionShaSource": {
          "type": "string",
          "minLength": 1,
          "description": "上面那个 SHA 的出处；没有出处就不允许出现断言。"
        },
        "productionBranch": {
          "type": [
            "string",
            "null"
          ],
          "description": "项目级 Production Branch。与 productionBranchSource 成对：断言必须有出处，没有出处的分支不写在这里。"
        },
        "productionBranchSource": {
          "type": [
            "string",
            "null"
          ],
          "description": "上面那个分支的出处（例如 vercel api /v9/projects/<name> 的 link.productionBranch 只读回读）。"
        }
      }
    },
    "managedSurfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "受本策略管理的文件（相对仓库根）。校验器要求每一个都真实存在——列一个不存在的路径等于没有管理它。"
    },
    "unresolved": {
      "type": "array",
      "description": "**未知不猜。** 任何不能核实的外部事实都必须落在这里：`value` 只能是 null，`probe` 写清楚怎么核的、什么结果。把猜测写成事实，比留空更危险。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "what",
          "why",
          "probe",
          "checkedOn",
          "value"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "what": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "probe": {
            "type": "string",
            "minLength": 1
          },
          "checkedOn": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "value": {
            "type": "null",
            "description": "恒为 null：无法核实就是无法核实，这里不允许出现猜出来的值。"
          }
        }
      }
    },
    "note": {
      "type": "string",
      "minLength": 1
    }
  }
}
